# --- Application ---
APP_ENV=dev
APP_SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- BigBlueButton ---
# Server-to-server API base (what the backend calls). Must end with /bigbluebutton/
BBB_URL=http://your-bbb-server.com/bigbluebutton/
# Browser-facing base for candidate/interviewer join URLs — only needed when
# the public hostname differs from BBB_URL (e.g. Docker: BBB_URL=http://bbb:8080/...,
# BBB_PUBLIC_URL=https://bbb.example.com/...). Falls back to BBB_URL when empty.
BBB_PUBLIC_URL=
BBB_SHARED_SECRET=change-me
# Local development alternative: run the bundled mock BBB instead of a real
# server (docker-compose.yml service `mockbbb`):
#   BBB_URL=http://mockbbb:9090/bigbluebutton/
#   BBB_PUBLIC_URL=http://localhost:5174/bigbluebutton   (web origin; nginx
#       proxies /bigbluebutton/ to the mock — one origin for SPA + room)
#   BBB_SHARED_SECRET=dev-mock-secret-localhost
BBB_WEBHOOK_PATH_TOKEN=change-me-to-a-random-path-token
BBB_WEBHOOK_VERIFY=none            # none | api  (checksum convention check)
BBB_AUTO_JOIN=true

# --- Mail (empty SMTP_HOST = console mailer, emails printed to logs) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Interviews <interviews@example.com>
SMTP_STARTTLS=true

# --- Scheduling / jobs ---
REMINDER_HOURS_BEFORE=24
REMINDER_MINUTES_BEFORE=15
NO_SHOW_GRACE_MINUTES=10
JOB_SWEEP_SECONDS=60
KEEP_RAW_RECORDING=false
CAPTION_LANGUAGES=en
